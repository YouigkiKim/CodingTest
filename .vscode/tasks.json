{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: build active file (debug)",
            "type": "shell",
            "command": "mkdir -p '${workspaceFolder}/build/debug' && g++ -std=c++17 -Wall -Wextra -g -O0 '${file}' -o '${workspaceFolder}/build/debug/${fileBasenameNoExtension}'",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: build and run active file",
            "type": "shell",
            "command": "mkdir -p '${workspaceFolder}/build/debug' && g++ -std=c++17 -Wall -Wextra -g -O0 '${file}' -o '${workspaceFolder}/build/debug/${fileBasenameNoExtension}' && '${workspaceFolder}/build/debug/${fileBasenameNoExtension}'",
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: build and run active file (ASan+UBSan)",
            "type": "shell",
            "command": "mkdir -p '${workspaceFolder}/build/debug' && g++ -std=c++17 -Wall -Wextra -g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer '${file}' -o '${workspaceFolder}/build/debug/${fileBasenameNoExtension}_asan' && '${workspaceFolder}/build/debug/${fileBasenameNoExtension}_asan'",
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}